<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HRMS Cross-Platform E2E Suite" verbose="2" parallel="false">
    
    <listeners>
        <listener class-name="com.rankbook.hrms.automation.reporting.listeners.AllureReportListener" />
    </listeners>

    <parameter name="deviceName" value="Pixel 8 API 37.2" />

    <test name="Cross-Platform Mobile-Web Attendance Sync">
        <classes>
            <class name="com.rankbook.hrms.automation.tests.mobile.GeofencePunchInTests" />
            <class name="com.rankbook.hrms.automation.tests.e2e.CrossPlatformPunchSyncTest" />
        </classes>
    </test>

</suite>