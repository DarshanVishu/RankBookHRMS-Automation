<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="HRMS Complete Regression Suite" verbose="2">
    <listeners>
        <listener class-name="com.rankbook.hrms.automation.reporting.listeners.AllureReportListener" />
    </listeners>

    <parameter name="deviceName" value="Pixel 8 API 37.2" />

    <!-- 1. API Verification (Fastest Feedback) -->
    <test name="API Tests">
        <packages>
            <package name="com.rankbook.hrms.automation.tests.api" />
        </packages>
    </test>

    <!-- 2. Web UI Tests -->
    <test name="Web Portal Tests">
        <packages>
            <package name="com.rankbook.hrms.automation.tests.web" />
        </packages>
    </test>

    <!-- 3. Mobile UI Tests -->
    <test name="Android Native Tests">
        <packages>
            <package name="com.rankbook.hrms.automation.tests.mobile" />
        </packages>
    </test>

    <!-- 4. End-to-End Cross-Platform Sync -->
    <test name="Cross-Platform E2E Tests">
        <packages>
            <package name="com.rankbook.hrms.automation.tests.e2e" />
        </packages>
    </test>
</suite>